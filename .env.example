# PostgreSQL connection for Drizzle and Better Auth.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/oprc

# Generate a high-entropy secret with at least 32 characters for production.
BETTER_AUTH_SECRET=replace-with-a-strong-random-secret

# Public origin of the TanStack Start application.
BETTER_AUTH_URL=http://localhost:3000

# Browser auth endpoint. Keep this aligned with BETTER_AUTH_URL locally.
VITE_AUTH_URL=http://localhost:3000

# Public API origin embedded in EAS preview and production mobile builds.
# Leave unset while using the local Expo Go or development-build workflow.
EXPO_PUBLIC_API_URL=https://api.example.com

# Change before distributing a native app. Must be a unique reverse-DNS identifier.
EXPO_APP_IDENTIFIER=com.example.oprctemplate
