{
    "name": "oprc-template",
    "private": true,
    "scripts": {
        "build": "turbo run build",
        "dev": "pnpm run with-env turbo run dev",
        "with-env": "dotenv -e .env --",
        "prepare": "husky",
        "db:generate": "pnpm --filter @repo/db db:generate",
        "db:migrate": "pnpm --filter @repo/db db:migrate",
        "lint": "turbo run lint",
        "format": "biome format --write .",
        "format:check": "biome format .",
        "check": "biome check .",
        "check-types": "turbo run check-types"
    },
    "devDependencies": {
        "@biomejs/biome": "catalog:",
        "@repo/biome-config": "workspace:*",
        "dotenv-cli": "catalog:",
        "husky": "^9.1.7",
        "lint-staged": "^17.4.1",
        "turbo": "^2.10.12",
        "typescript": "catalog:"
    },
    "lint-staged": {
        "**/*.{js,cjs,mjs,ts,tsx,jsx,json,jsonc,css,md,yaml,yml}": "biome check --write"
    },
    "packageManager": "pnpm@11.23.0",
    "engines": {
        "node": ">=24"
    }
}
